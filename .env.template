# LuneCare - Environment Variables Template
# Copy this file to `.env` and replace all placeholder values with actual credentials.
# Example: cp .env.template .env
# 
# IMPORTANT:
# - Never commit your `.env` file to Git.
# - Add `.env` to `.gitignore`.
# - Use strong secrets in production.
# - Keep production credentials in a secure secret manager whenever possible.


# Cloudinary Configuration - Used for image/media upload and CDN delivery.
# https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Configuration - Used for payment processing (India).
# https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# Stripe Configuration - Used for international payment processing and webhook handling.
# https://dashboard.stripe.com/
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# JWT Configuration - Token expiry values are in milliseconds.
JWT_ACCESS_TOKEN_EXPIRY=3600000 # 1 hour
JWT_REFRESH_TOKEN_EXPIRY=604800000 # 7 days

# Spring Cloud Config - Git Repository
# Production Config Server pulls configuration from this Git repository.
# IMPORTANT:
# - GIT_PASSWORD should be a GitHub Personal Access Token (PAT).
# - Never use your GitHub account password.
# Example: GIT_URI=https://github.com/your-username/config-repo.git
GIT_URI=
GIT_USERNAME=
GIT_PASSWORD=

# PostgreSQL Database Configuration
# Architecture Decision: A single PostgreSQL database is used with multiple schemas instead of
# database-per-service architecture.
# Reason: Reduces memory usage, Faster bootstrap/startup, Simpler local development 
# Each microservice uses a dedicated schema.
#
# Example JDBC URL:
# jdbc:postgresql://postgres:5432/lunecare?currentSchema=auth
#
# Change only: currentSchema=<service_schema>
# Credentials remain same for all services for dev & docker environments.
# Example Schemas: auth, patient, doctor, appointment, payment
#
# You can switch to database-per-service architecture if needed by updating the production configuration files.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=lunecare
POSTGRES_USER=
POSTGRES_PASSWORD=

# MongoDB Configuration
# Some services use MongoDB (e.g. notification, feedback).
#
# Similar to PostgreSQL setup:
# - Same MongoDB instance
# - Different database per service
#
# Example URI:
# mongodb://username:password@localhost:27017/notification_db?authSource=admin
MONGO_HOST=
MONGO_PORT=27017
MONGO_USERNAME=
MONGO_PASSWORD=

# Redis Configuration
# Used for: Caching, Token blacklisting, Rate limiting, Session storage
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration
# Used for asynchronous communication between microservices.
# Example Use Cases: BusRefresh, Notification events, Payment processing events
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Eureka Service Discovery Configuration
# Eureka is used for service registration and discovery.
# Replace `prod-eureka-host` with actual production hostname/IP.
EUREKA_DEFAULT_ZONE=http://prod-eureka-host:8761/eureka
EUREKA_HOSTNAME=prod-eureka-host

# 📌 Additional Notes
# ✅ Use different credentials for dev/staging/prod
# ✅ Rotate secrets periodically
# ✅ Restrict database/network access
# ✅ Use HTTPS in production
# ✅ Store secrets in:
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Doppler
#    - GCP Secret Manager
#
# Never expose:
# - API Keys
# - JWT secrets
# - Database passwords
# - PAT tokens